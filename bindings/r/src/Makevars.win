TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu

TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libgliph2rs.a
PKG_LIBS = -L$(LIBDIR) -lgliph2rs -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

# The core crate is vendored into rust/core so the package is self-contained.
VENDOR = ./rust/core
CORE = $(CURDIR)/../../..

all: C_clean

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo

# Refresh the vendored crate from the repository on every build, so a working
# tree never compiles stale sources. A source tarball has no repository above
# the package, and ships the copy instead. `vendor` names no file, so it
# always runs; no GNU make extensions are used.
vendor:
	if [ -f "$(CORE)/Cargo.toml" ]; then \
		mkdir -p $(VENDOR) && \
		cp "$(CORE)/Cargo.toml" $(VENDOR)/Cargo.toml && \
		rm -Rf $(VENDOR)/src && cp -R "$(CORE)/src" $(VENDOR)/src; \
	elif [ ! -f "$(VENDOR)/Cargo.toml" ]; then \
		echo "ERROR: core crate missing at $(CORE) and not vendored in $(VENDOR)" >&2; \
		exit 1; \
	fi

$(STATLIB): vendor
	mkdir -p $(TARGET_DIR)/libgcc_mock && touch $(TARGET_DIR)/libgcc_mock/libgcc_eh.a
	if [ "$(NOT_CRAN)" != "true" ]; then \
		export CARGO_HOME=$(CARGOTMP); \
	fi && \
		export LIBRARY_PATH="$${LIBRARY_PATH};$(CURDIR)/$(TARGET_DIR)/libgcc_mock" && \
		export PATH="$(PATH):$(HOME)/.cargo/bin" && \
		cargo build --target=$(TARGET) --lib --release --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)
	if [ "$(NOT_CRAN)" != "true" ]; then \
		rm -Rf $(CARGOTMP) && \
		rm -Rf $(LIBDIR)/build; \
	fi

C_clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB)

# $(VENDOR) is deliberately kept: R CMD build runs `clean` on its temporary
# copy of the package, and the vendored crate must survive into the tarball.
clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) rust/target

distclean: clean
	rm -Rf $(VENDOR)

.PHONY: all vendor C_clean clean distclean
